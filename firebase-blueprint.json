{
  "entities": {
    "ConnectionProbe": {
      "title": "ConnectionProbe",
      "description": "Heartbeat and verification probe confirming connectivity to the Firestore database",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Status of the connection probe"
        },
        "databaseId": {
          "type": "string",
          "description": "Target database identifier"
        },
        "clientApp": {
          "type": "string",
          "description": "App identity pinging the database"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the probe request"
        }
      },
      "required": ["status", "databaseId", "clientApp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name, custom user ID handle, and associated IP addresses",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user handle / ID"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "customUserId": {
          "type": "string",
          "description": "Custom alphanumeric user handle"
        },
        "associatedIps": {
          "type": "array",
          "description": "List of IP addresses linked to this account"
        },
        "currentIp": {
          "type": "string",
          "description": "Most recently active IP address"
        },
        "createdAt": {
          "type": "string",
          "description": "Registration ISO timestamp"
        }
      },
      "required": ["userId", "displayName", "customUserId"]
    },
    "UserContact": {
      "title": "UserContact",
      "description": "Saved contact entry in user roster",
      "type": "object",
      "properties": {
        "contactUserId": {
          "type": "string",
          "description": "User ID of the added contact"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the contact"
        },
        "currentIp": {
          "type": "string",
          "description": "Last known IP address"
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp when added"
        }
      },
      "required": ["contactUserId", "displayName"]
    },
    "RegisteredIpEntry": {
      "title": "RegisteredIpEntry",
      "description": "Fast lookup mapping an IP address to registered user identity",
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "description": "Registered public or device IP address"
        },
        "userId": {
          "type": "string",
          "description": "Associated user account handle"
        },
        "customUserId": {
          "type": "string",
          "description": "Associated user custom handle"
        },
        "displayName": {
          "type": "string",
          "description": "Associated user display name"
        },
        "registeredAt": {
          "type": "string",
          "description": "Timestamp when IP was linked"
        }
      },
      "required": ["ip", "userId", "customUserId", "displayName"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Two-way synchronized conversation thread between mesh peers",
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "description": "Unique deterministic identifier of the thread"
        },
        "participantIds": {
          "type": "array",
          "description": "List of participant user handles"
        },
        "lastMessage": {
          "type": "string",
          "description": "Last sent preview snippet"
        },
        "lastSenderId": {
          "type": "string",
          "description": "Handle of last sender"
        },
        "lastSenderName": {
          "type": "string",
          "description": "Display name of last sender"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last dispatch"
        }
      },
      "required": ["threadId", "participantIds", "lastMessage"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Encrypted message item in thread subcollection",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique identifier of the message"
        },
        "threadId": {
          "type": "string",
          "description": "ID of thread"
        },
        "senderId": {
          "type": "string",
          "description": "Sender handle"
        },
        "senderName": {
          "type": "string",
          "description": "Sender display name"
        },
        "content": {
          "type": "string",
          "description": "Encrypted message content"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of dispatch"
        }
      },
      "required": ["messageId", "threadId", "senderId", "content"]
    }
  },
  "firestore": {
    "/connection_probes/{probeId}": {
      "schema": {
        "$ref": "#/entities/ConnectionProbe"
      },
      "description": "Collection of system connectivity validation probes"
    },
    "/registered_ips/{ipKey}": {
      "schema": {
        "$ref": "#/entities/RegisteredIpEntry"
      },
      "description": "Global index mapping detected IP addresses to registered user identities"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User account profiles"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": {
        "$ref": "#/entities/UserContact"
      },
      "description": "User saved contacts roster"
    },
    "/threads/{threadId}": {
      "schema": {
        "$ref": "#/entities/ChatThread"
      },
      "description": "Shared two-way conversation threads"
    },
    "/threads/{threadId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages inside conversation thread"
    }
  }
}
