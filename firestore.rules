rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidProbe(data) {
      return ('status' in data)
        && ('databaseId' in data)
        && ('clientApp' in data)
        && data.status is string
        && data.databaseId is string
        && data.clientApp is string;
    }

    function isValidRegisteredIp(data) {
      return ('ip' in data)
        && ('userId' in data)
        && ('customUserId' in data)
        && ('displayName' in data)
        && data.ip is string
        && data.userId is string
        && data.customUserId is string
        && data.displayName is string;
    }

    function isValidUser(data, userId) {
      return ('userId' in data)
        && ('displayName' in data)
        && ('customUserId' in data)
        && data.userId == userId
        && data.displayName is string
        && data.customUserId is string;
    }

    function isValidContact(data) {
      return ('contactUserId' in data)
        && ('displayName' in data)
        && data.contactUserId is string
        && data.displayName is string;
    }

    function isValidThread(data, userId) {
      return ('threadId' in data)
        && ('creatorId' in data)
        && ('title' in data)
        && data.creatorId == userId
        && data.threadId is string
        && data.title is string;
    }

    function isValidSharedThread(data) {
      return ('threadId' in data)
        && ('participantIds' in data)
        && ('lastMessage' in data)
        && data.threadId is string
        && data.participantIds is list
        && data.lastMessage is string;
    }

    function isValidMessage(data) {
      return ('messageId' in data)
        && ('threadId' in data)
        && ('senderId' in data)
        && ('content' in data)
        && data.messageId is string
        && data.threadId is string
        && data.senderId is string
        && data.content is string;
    }

    // Connection probe endpoint for connectivity verification
    match /connection_probes/{probeId} {
      allow read: if true;
      allow write: if isValidProbe(request.resource.data);
    }

    // Registered IP index for IP-only device recognition & admin deletion
    match /registered_ips/{ipKey} {
      allow read: if true;
      allow create, update: if isValidRegisteredIp(request.resource.data);
      allow delete: if true;
    }

    // User account profiles identified by custom user ID & admin deletion
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data, userId);
      allow delete: if true;

      match /contacts/{contactId} {
        allow read: if true;
        allow create, update: if isValidContact(request.resource.data);
        allow delete: if true;
      }

      match /threads/{threadId} {
        allow read, write: if isValidThread(request.resource.data, userId);
      }
    }

    // Two-way shared threads and realtime message dispatches
    match /threads/{threadId} {
      allow read: if true;
      allow create, update: if isValidSharedThread(request.resource.data);
      allow delete: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if isValidMessage(request.resource.data);
        allow delete: if true;
      }
    }
  }
}
